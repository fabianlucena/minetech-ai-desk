{
  "expo": {
    "name": "Minetech IA Desk",
    "slug": "minetech-iadesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/minetech-icon-transparent.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#BE9B23",
        "foregroundImage": "./assets/minetech-logo.png",
        "backgroundImage": "./assets/minetech-logo.png",
        "monochromeImage": "./assets/minetech-logo.png"
      },
      "package": "com.fabianlucena.minetechiadesk"
    },
    "web": {
      "favicon": "./assets/minetech-icon-transparent.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/minetech-logo-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#BE9B23"
        }
      ],
      "@react-native-vector-icons/material-icons"
    ]
  }
}
