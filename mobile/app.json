{
  "expo": {
    "name": "Minetech IA Desk",
    "slug": "minetech-iadesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/minetech-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.minetech.iadesk",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/minetech-logo.png",
        "monochromeImage": "./assets/minetech-logo-mono.png"
      }
    },
    "web": {
      "favicon": "./assets/minetech-logo.png"
    },
    "plugins": [
      "@react-native-vector-icons/material-icons",
      [
        "expo-splash-screen",
        {
          "image": "./assets/minetech-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#BE9B23",
          "imageWidth": 300,
          "android": {
            "resizeMode": "contain",
            "backgroundColor": "#BE9B23"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/minetech-logo-notification-mono.png",
          "color": "#BE9B23"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3dc24fbe-5de9-495c-876a-70a2505e8640"
      }
    },
    "owner": "fabianlucena"
  }
}
